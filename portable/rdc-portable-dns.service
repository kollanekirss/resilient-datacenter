[Unit]
Description=RDC local-only DNS
Requires=rdc-portable-firewall.service
After=network.target rdc-portable-firewall.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/sbin/unbound-checkconf /etc/unbound/rdc-portable.conf
ExecStart=/usr/sbin/unbound -d -c /etc/unbound/rdc-portable.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
