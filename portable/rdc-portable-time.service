[Unit]
Description=RDC explicitly selected local time reference
Requires=rdc-portable-firewall.service
After=network.target rdc-portable-firewall.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/sbin/chronyd -n -f /etc/chrony/rdc-portable.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
